{
  "version": 1,
  "kind": "shopify_connector_source",
  "connectorId": "<tender-connector-id>",
  "instanceId": "default",
  "shopDomain": "<shop-name>.myshopify.com",
  "adminApiVersion": "2026-04",
  "clientId": "<shopify-client-id>",
  "scopes": [
    "read_discounts",
    "write_discounts",
    "read_products"
  ],
  "shopify": {
    "extensions": [
      {
        "type": "theme",
        "handle": "coupon-widget",
        "sourcePath": "extensions/coupon-widget/shopify.extension.toml",
        "runtimeUrl": "<published-tender-app-url>/client.js",
        "stylesheetUrl": "<published-tender-app-url>/styles.css",
        "blocks": [
          {
            "handle": "selectable_coupon",
            "sourcePath": "extensions/coupon-widget/blocks/selectable_coupon.liquid"
          },
          {
            "handle": "selectable_coupon_collection_embed",
            "sourcePath": "extensions/coupon-widget/blocks/selectable_coupon_collection_embed.liquid"
          }
        ]
      },
      {
        "type": "function",
        "handle": "selectable-coupon-discount",
        "target": "cart.lines.discounts.generate.run",
        "sourcePath": "extensions/product-coupon-discount/shopify.extension.toml"
      },
      {
        "type": "admin_ui_extension",
        "handle": "coupon-admin-home",
        "sourcePath": "extensions/admin-home/shopify.extension.toml"
      }
    ]
  },
  "secrets": {
    "clientSecret": "stored in Tender connector credentials, not in this source tree",
    "appAutomationToken": "stored in Tender connector secret store, not in this source tree"
  },
  "tenderApps": [
    {
      "name": "Selectable Coupon App",
      "artifactId": "<tender-artifact-id>",
      "elementTag": "tender-coupon-widget",
      "runtimeUrl": "<published-tender-app-url>/client.js",
      "stylesheetUrl": "<published-tender-app-url>/styles.css",
      "publishedReleaseId": "<published-release-id>",
      "blockHandle": "selectable_coupon",
      "collectionEmbedHandle": "selectable_coupon_collection_embed",
      "functionHandle": "selectable-coupon-discount"
    }
  ]
}
